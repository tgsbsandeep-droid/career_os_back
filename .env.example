# CareerOS backend — copy to .env and fill real keys.
#   copy .env.example .env
# Never commit .env. The API loads this file from backend/.env only.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Local:  PORT=5000  NODE_ENV=development  FRONTEND_URL=http://localhost:5173
# Live:   NODE_ENV=production  FRONTEND_URL=https://career-os.pages.dev
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins (comma-separated), e.g. custom domain + pages.dev
# Live example: FRONTEND_URLS=https://career-os.pages.dev,https://www.careeros.app
FRONTEND_URLS=

# -----------------------------------------------------------------------------
# Supabase (Auth + DB) — required
# Dashboard: Project Settings → API
# Same project URL/key as frontend VITE_SUPABASE_*
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional. Never put this on the frontend. Needed only for admin/server jobs.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Google Gemini — required for AI Mate / career coach / resume / interview
# Keep the real key in backend/.env only.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# -----------------------------------------------------------------------------
# Email (interview invitations). Prefer Resend; SMTP is the fallback.
# Leave blank to skip sending — in-app interview details still work.
# Live: set RESEND_API_KEY (recommended) OR SMTP_*
# -----------------------------------------------------------------------------
MAIL_FROM=CareerOS <noreply@careeros.app>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Google / LinkedIn OAuth
# Configure in Supabase Dashboard → Authentication → Providers (not in code).
# Local redirect:  http://localhost:5173/auth/callback
# Live redirect:   https://yourdomain.com/auth/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
