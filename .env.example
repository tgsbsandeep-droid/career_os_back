PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Google Gemini (AI Mate). Keep the real key in backend/.env only.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Optional interview emails. Prefer Resend; SMTP is the fallback.
# Leave unset to skip sending (in-app interview details still work).
MAIL_FROM=CareerOS <noreply@careeros.app>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
