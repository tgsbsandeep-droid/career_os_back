# CareerOS backend — copy to .env and fill real keys.
#   copy .env.example .env
# Never commit .env. The API loads this file from backend/.env only.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Local:  PORT=5000  NODE_ENV=development  FRONTEND_URL=http://localhost:5173
# Live:   NODE_ENV=production  FRONTEND_URL=https://career-os-front.pages.dev
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins (comma-separated), e.g. custom domain + pages.dev
# Live example: FRONTEND_URLS=https://career-os.pages.dev,https://www.careeros.app
FRONTEND_URLS=

# -----------------------------------------------------------------------------
# Supabase (Auth + DB) — required
# Dashboard: Project Settings → API
# Same project URL/key as frontend VITE_SUPABASE_*
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...your_supabase_anon_key
# Optional. Never put this on the frontend. Needed only for admin/server jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Used to verify JWT signatures locally on clock-skew fallback.
# Dashboard: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Google Gemini — required for AI Mate / career coach / resume / interview
# Keep the real key in backend/.env only.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# -----------------------------------------------------------------------------
# Email (interview invitations) — powered by EmailJS REST API.
# Leave blank to skip sending — in-app interview details still work.
# EmailJS dashboard: https://dashboard.emailjs.com
#   1. Email Services  → Add New Service → connect Gmail/Outlook/etc → copy Service ID
#   2. Email Templates → Create Template → add variables below  → copy Template ID
#      Required template variables:
#        {{to_email}}     — recipient email address
#        {{to_name}}      — candidate name
#        {{subject}}      — email subject line
#        {{html_message}} — full HTML body
#        {{message}}      — plain-text fallback body
#   3. Account → General → Public Key  (user_id)
#   4. Account → General → Private Key (accessToken — needed for server-side calls)
# -----------------------------------------------------------------------------
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Private key is required for server-side (backend) calls without browser context
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# -----------------------------------------------------------------------------
# Google / LinkedIn OAuth
# Configure in Supabase Dashboard → Authentication → Providers (not in code).
# Local redirect:  http://localhost:5173/auth/callback
# Live redirect:   https://yourdomain.com/auth/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
